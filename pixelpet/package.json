{
  "name": "pixelpet",
  "version": "0.1.0",
  "description": "Desktop pixel pet (Electron port)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.pixelpet.electron",
    "productName": "PixelPet",
    "files": ["main.js", "preload.js", "index.html", "renderer.js", "colors.js", "styles.css"],
    "artifactName": "${productName}-${version}.${ext}",
    "win": { "target": "portable", "icon": "icon.ico" },
    "mac": { "target": "dmg", "category": "public.app-category.utilities" }
  }
}
