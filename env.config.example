# env.config template — run `cp env.config.example env.config` and replace the placeholders below.
# MASTER_PW must be changed. NGROK_* and PIXELPET_SERVER are only needed for public (ngrok) hosting.
# See the "Configuration (Master)" section in README.md for details.

MASTER_PW=0000
NGROK_DOMAIN=your-domain.ngrok-free.dev
NGROK_PATH=ngrok
PIXELPET_SERVER=https://your-domain.ngrok-free.dev
